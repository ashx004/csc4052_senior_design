NEXT_PUBLIC_FIREBASE_API_KEY=
# MinIO is only ever called server-side (every document access — browser
# viewing, read_document, embed-document — goes through this app's own
# /api/download route, never directly to MinIO). If this app and MinIO run
# on the same LAN/machine, a LAN-direct http:// endpoint (e.g.
# http://192.168.1.11:9069) is a same-machine call with zero downside vs
# the public https:// domain — src/library/minioClient.ts derives TLS from
# whichever scheme is set here, so either works without other changes.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GEMINI_API_KEY=
# _URL is tried first (LAN-direct — measured ~11-18x lower latency than the
# public tunnel), _FALLBACK_URL is used automatically if it's unreachable
# (e.g. developing off the home LAN) — see src/library/ollamaClient.ts's
# resolveOllamaBaseUrl, which probes reachability with a short cached
# timeout so a slow-but-working LAN response is never mistaken for "down".
# IMPORTANT: both values must always point at the Caddy auth-proxy in front
# of Ollama (ollama-proxy/Caddyfile on each box — checks the Bearer token),
# never a raw Ollama container port directly, on either the LAN or public
# path. Fallback is optional — leave it blank to only ever use the primary
# value, e.g. for the deployed instance which always runs on the same LAN.
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_FALLBACK_URL=
OLLAMA_SECONDARY_URL=
OLLAMA_SECONDARY_FALLBACK_URL=
OLLAMA_AUTH_TOKEN=
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
OLLAMA_SUMMARY_MODEL=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
INTERNAL_API_SECRET=
COURSE_OFFERING_SOURCE_URL=
QDRANT_URL=
QDRANT_API_KEY=
# Set to "false" to disable the small-model query-clarification pass
# (src/library/queryClarifier.ts) that restates a student's raw message
# before the primary model responds — on by default whenever the secondary
# Ollama box is configured.
ENABLE_QUERY_CLARIFICATION=