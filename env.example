NEXT_PUBLIC_FIREBASE_API_KEY=
MINIO_ENDPOINT=
# Public fallback used when MINIO_ENDPOINT (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
MINIO_ENDPOINT_FALLBACK=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GEMINI_API_KEY=
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_FALLBACK_URL=
OLLAMA_SECONDARY_URL=
OLLAMA_SECONDARY_FALLBACK_URL=
OLLAMA_AUTH_TOKEN=
# Default/shared model, used as a fallback wherever a more specific
# OLLAMA_MODEL_* var below isn't set - see src/library/ollamaClient.ts's
# resolveModelFromKey for how the settings page's per-task model choice
# actually resolves to one of these.
OLLAMA_MODEL=
# The "fastResident" model key (src/library/chatMode.ts) resolves here - a
# selectable option, not the default, small enough to sit resident on
# Primary alongside another model without evicting it.
OLLAMA_MODEL_FAST=
# The "qwen3A3b" model key resolves here - fastest of the 4 models
# benchmarked 2026-08-13 (188.5 tok/s avg against this app's real
# prompts/schemas/tools), selectable but not the default (see
# OLLAMA_MODEL_MUSE_GLIMMER below for why). Known issue: this model can leak
# raw <think> reasoning into its output even with think:false - the chat
# route buffers and strips it before streaming to the client (see
# wrapDeltaForThinkStripping).
OLLAMA_MODEL_QUALITY=
# Per-task model options for the settings page (AI Chat / Quiz / Flashcard
# Generation dropdowns) and the "Reduce cold boots" unified-model option -
# see src/library/chatMode.ts's TASK_MODEL_OPTIONS/UNIFIED_MODEL_OPTIONS
# for the practical-first ordering these feed the dropdowns, and
# src/library/ollamaClient.ts's resolveModelFromKey for how a selection
# resolves to one of these. Benchmarked 2026-08-13 on ollama-primary
# against this app's actual prompts/schemas/tools (flashcard/quiz JSON
# generation, the real tool-calling chat flow through a full multi-round
# tool loop) - all three below correctly emit tool_calls and produce valid
# structured output.
# "museGlimmer" key - 31.7 tok/s avg, best response quality/prose of the 4
# models tested. THE APP-WIDE DEFAULT as of 2026-08-16 (see
# DEFAULT_TASK_MODEL/DEFAULT_UNIFIED_MODEL in chatMode.ts): it's the only
# one of the 4 with a real native vision encoder (confirmed via `ollama
# show`'s projector_info, and a 6-image OCR accuracy test scoring 6/6 exact
# transcriptions against the previous dedicated OCR model), so defaulting
# chat/quiz/flashcards to it too means chat and OCR share one resident
# model app-wide instead of two competing for the same VRAM. See
# OLLAMA_OCR_MODEL and OLLAMA_MODEL_KEEP_ALIVE below.
OLLAMA_MODEL_MUSE_GLIMMER=
# "nemotron" key - 106.8 tok/s avg.
OLLAMA_MODEL_NEMOTRON=
# "qwenCoder" key - 179.4 tok/s avg, cleanest structured-output + tool-use
# reliability of the 4, with no known issues.
OLLAMA_MODEL_QWEN_CODER=
OLLAMA_EMBED_MODEL=
OLLAMA_SUMMARY_MODEL=
# Vision/OCR model - defaults to muse-glimmer:latest as of 2026-08-16 (was
# qwen3-vl:8b), since the app-wide default chat model now has native vision
# and there's no reason to keep a second, smaller vision-only model
# resident alongside it. Kept as its own env var (not folded into
# OLLAMA_MODEL_MUSE_GLIMMER) so ocrClient.ts's real document-OCR calls and
# resolveModelFromKey's "ocr" pre-warm key stay sourced from one place, in
# case they ever need to point at a different model than plain chat again.
OLLAMA_OCR_MODEL=
# How long the effective chat/OCR model stays resident after its last use
# before Ollama unloads it (see FAST_MODEL_KEEP_ALIVE in ollamaClient.ts).
# Defaults to 1h if unset. Since every task now funnels onto one shared
# model by default, reloading from cold costs more (it's serving
# everything, not just one task) - worth setting higher than 1h in an
# environment where that one model is doing double or triple duty.
OLLAMA_MODEL_KEEP_ALIVE=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
INTERNAL_API_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
COURSE_OFFERING_SOURCE_URL=
QDRANT_URL=
# Public fallback used when QDRANT_URL (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
QDRANT_FALLBACK_URL=
QDRANT_API_KEY=

# Set to "false" to disable the small-model query-clarification pass
# (src/library/queryClarifier.ts) that restates a student's raw message
# before the primary model responds
ENABLE_QUERY_CLARIFICATION=
