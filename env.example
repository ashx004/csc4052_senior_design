NEXT_PUBLIC_FIREBASE_API_KEY=
MINIO_ENDPOINT=
# Public fallback used when MINIO_ENDPOINT (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
MINIO_ENDPOINT_FALLBACK=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GEMINI_API_KEY=
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_FALLBACK_URL=
OLLAMA_SECONDARY_URL=
OLLAMA_SECONDARY_FALLBACK_URL=
OLLAMA_AUTH_TOKEN=
# The app's one large model. Everything on Ollama Primary uses it: AI Chat,
# quiz/flashcard generation, AI advising, Discover question generation,
# course summaries, AND OCR/vision (Muse Glimmer is multimodal enough to
# cover that too) - see src/library/ollamaClient.ts's resolveModelFromKey,
# the single choke point all of those call through. No other large model is
# used anywhere (VRAM is limited) - there is no per-task model choice.
OLLAMA_MODEL_MUSE_GLIMMER=muse-glimmer:latest
# Small models only, for the outsourced background tasks (Secondary):
# embeddings, plus llama3.2:3b for conversation compaction / student
# profile (OLLAMA_SUMMARY_MODEL), query clarification, and contextual
# chunking.
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_SUMMARY_MODEL=llama3.2:3b
OLLAMA_CLARIFIER_MODEL=llama3.2:3b
OLLAMA_CONTEXT_MODEL=llama3.2:3b
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
INTERNAL_API_SECRET=
# Long-running document jobs are processed outside browser requests. Point
# this at this deployment's protected worker endpoint, for example
# https://app.example.edu/api/document-jobs/worker.
OCR_WORKER_URL=
OCR_WORKER_POLL_MS=10000
# Same reasoning as OCR above, for advising's transcript/curriculum
# extraction (up to 4 sequential AI calls per upload). Point this at this
# deployment's protected worker endpoint, for example
# https://app.example.edu/api/advising-jobs/worker.
ADVISING_WORKER_URL=
ADVISING_WORKER_POLL_MS=10000
# Advising model settings (see src/library/advisingOllama.ts). NUM_CTX is
# the model's whole context window - prompt, document AND reply must fit
# in it, or Ollama silently truncates. THINK_MODE=off skips reasoning
# tokens, which would otherwise eat that same window.
ADVISING_THINK_MODE=off
ADVISING_NUM_CTX=32768
ADVISING_OLLAMA_TIMEOUT_MS=1200000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
COURSE_OFFERING_SOURCE_URL=
QDRANT_URL=
# Public fallback used when QDRANT_URL (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
QDRANT_FALLBACK_URL=
QDRANT_API_KEY=

# Set to "false" to disable the small-model query-clarification pass
# (src/library/queryClarifier.ts) that restates a student's raw message
# before the primary model responds
ENABLE_QUERY_CLARIFICATION=
