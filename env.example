NEXT_PUBLIC_FIREBASE_API_KEY=
MINIO_ENDPOINT=
# Public fallback used when MINIO_ENDPOINT (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
MINIO_ENDPOINT_FALLBACK=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GEMINI_API_KEY=
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_FALLBACK_URL=
OLLAMA_SECONDARY_URL=
OLLAMA_SECONDARY_FALLBACK_URL=
OLLAMA_AUTH_TOKEN=
# Default/shared model, used as a fallback wherever OLLAMA_MODEL_FAST or
# OLLAMA_MODEL_QUALITY isn't set - see src/library/chatMode.ts and
# src/app/api/chat/route.ts for how those two are actually selected.
OLLAMA_MODEL=
# Fast mode: kept always-resident on Primary alongside the vision model -
# zero cold-boot swaps, ever, including for OCR.
OLLAMA_MODEL_FAST=
# Quality mode: noticeably better/faster chat, but evicts (and gets evicted
# by) the vision model, so OCR right after a Quality-mode message costs a
# cold-boot swap. Known issue: this model can leak raw <think> reasoning
# into its output even with think:false - the chat route buffers and strips
# it before streaming to the client, see wrapDeltaForThinkStripping.
OLLAMA_MODEL_QUALITY=
OLLAMA_EMBED_MODEL=
OLLAMA_SUMMARY_MODEL=
# Vision/OCR model - see the settings AI Chat Speed toggle and gatekeeper
# proxy in front of Ollama for why this competes with the main chat model
# for VRAM on Primary rather than always being resident alongside it.
OLLAMA_OCR_MODEL=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
INTERNAL_API_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
COURSE_OFFERING_SOURCE_URL=
QDRANT_URL=
# Public fallback used when QDRANT_URL (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
QDRANT_FALLBACK_URL=
QDRANT_API_KEY=

# Set to "false" to disable the small-model query-clarification pass
# (src/library/queryClarifier.ts) that restates a student's raw message
# before the primary model responds
ENABLE_QUERY_CLARIFICATION=
