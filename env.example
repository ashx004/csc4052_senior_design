NEXT_PUBLIC_FIREBASE_API_KEY=
MINIO_ENDPOINT=
MINIO_ENDPOINT_FALLBACK=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GEMINI_API_KEY=
# Every *_URL / *_ENDPOINT below takes the LAN address, and its
# *_FALLBACK_URL / *_FALLBACK may list several more, comma-separated, tried
# in order (see resolveReachableUrl.ts): Tailscale first, then the public
# Cloudflare tunnel. One env works everywhere - the public site hits LAN,
# a teammate on the tailnet gets Tailscale, anyone else gets Cloudflare.
#   OLLAMA_PRIMARY_URL=http://192.168.1.12:11434/primary
#   OLLAMA_PRIMARY_FALLBACK_URL=http://100.125.117.99:11434/primary,https://ollama1.zonocsc.com/primary
#   OLLAMA_SECONDARY_URL=http://192.168.1.11:11434/secondary
#   OLLAMA_SECONDARY_FALLBACK_URL=http://100.99.192.29:11434/secondary,https://ollama2.zonocsc.com/secondary
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_FALLBACK_URL=
OLLAMA_SECONDARY_URL=
OLLAMA_SECONDARY_FALLBACK_URL=
OLLAMA_AUTH_TOKEN=
# The one model Primary ever loads (chat, quiz/flashcard generation,
# advising, discover question generation - see resolveModelFromKey in
# ollamaClient.ts). Deliberately no code-level default: every caller throws
# a clear config error if this is unset rather than silently falling back
# to some hardcoded tag, so "which model runs" always lives here, not in
# source. Primary must NEVER be asked to load a second model alongside this
# one - its VRAM footprint alone already uses nearly the whole budget on
# this hardware, so anything else landing there evicts it (confirmed
# empirically). That's the whole reason OCR below runs on Secondary instead.
OLLAMA_MODEL_MAIN=qwen3:30b-a3b
OLLAMA_MODEL_KEEP_ALIVE=2h
# One num_ctx for EVERY main-model call (see mainModelContextOption in
# ollamaClient.ts) - a request with a different num_ctx makes Ollama reload
# the model. Ollama reserves KV cache for this x OLLAMA_NUM_PARALLEL (4 on
# Primary), so it must fit in VRAM alongside the weights: qwen3:30b-a3b at
# 32768 is 26.1GB fully on-GPU with OLLAMA_KV_CACHE_TYPE=q8_0 on the server
# (31.9GB, 1.4GB spilled to CPU, with the f16 default - 2026-09-24).
# ADVISING_NUM_CTX should match.
OLLAMA_MAIN_NUM_CTX=32768
ADVISING_NUM_CTX=32768
# Leave blank: advising must use the same resident model as everything else
# (a different tag here would load a second model on Primary and evict it).
OLLAMA_MODEL_ADVISING=
ADVISING_OLLAMA_TIMEOUT_MS=300000
# Per-feature thinking (see thinkMode.ts): on | off | omit | low/medium/high
# | levels (advising only). qwen3:30b-a3b is the 2507 Thinking build and
# reasons regardless, so for free-text features "on" is the clean choice
# (reasoning arrives separately instead of leaking into the reply). For the
# JSON-schema features "off" is genuinely ~5x faster (1.4s vs 7.3s measured) -
# the schema grammar leaves no room to reason.
OLLAMA_THINK_CHAT=on
OLLAMA_THINK_COURSE_SUMMARY=on
OLLAMA_THINK_QUIZ=off
OLLAMA_THINK_FLASHCARDS=off
OLLAMA_THINK_DISCOVER=off
ADVISING_THINK_MODE=on
# Models that reason even with think:false - chat buffers and strips their
# leaked reasoning when OLLAMA_THINK_CHAT is off (comma-separated tags).
OLLAMA_MODELS_ALWAYS_THINK=qwen3:30b-a3b
# SECONDARY (8GB) holds exactly two resident models: the embedder and
# qwen3-vl:4b-instruct, which does OCR (src/library/ocrClient.ts) AND every
# small text task below. The -instruct build matters: plain qwen3-vl:4b is a
# thinking model that ignores think:false and returned empty replies once
# its reasoning used up the output budget. A third model (e.g. llama3.2:3b)
# doesn't fit alongside these two - measured 2026-09-24, they evicted each
# other. OCR must never go to Primary (see OLLAMA_MODEL_MAIN above). No
# code-level defaults - each caller fails open (skips that feature) rather
# than falling back to Primary or a hardcoded tag.
OLLAMA_MODEL_OCR=qwen3-vl:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_SUMMARY_MODEL=qwen3-vl:4b-instruct
OLLAMA_CLARIFIER_MODEL=qwen3-vl:4b-instruct
OLLAMA_CONTEXT_MODEL=qwen3-vl:4b-instruct
# One num_ctx for every Secondary chat call (see secondaryContextOption) so
# OCR and the text tasks never reload the shared model. A phone photo of a
# notebook page alone is ~4,040 prompt tokens, so 4096 truncates OCR.
OLLAMA_SECONDARY_NUM_CTX=8192
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
INTERNAL_API_SECRET=
OCR_WORKER_URL=
OCR_WORKER_POLL_MS=10000
# Same reasoning as OCR above, for advising's transcript/curriculum
# extraction (up to 4 sequential AI calls per upload). Point this at this
# deployment's protected worker endpoint, for example
# https://app.example.edu/api/advising-jobs/worker.
ADVISING_WORKER_URL=
ADVISING_WORKER_POLL_MS=10000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
COURSE_OFFERING_SOURCE_URL=
QDRANT_URL=
QDRANT_FALLBACK_URL=
QDRANT_API_KEY=
# Set to "false" to disable the small-model query-clarification pass
# (src/library/queryClarifier.ts) that restates a student's raw message
# before the primary model responds
ENABLE_QUERY_CLARIFICATION=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
