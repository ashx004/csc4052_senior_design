NEXT_PUBLIC_FIREBASE_API_KEY=
MINIO_ENDPOINT=
# Public fallback used when MINIO_ENDPOINT (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
MINIO_ENDPOINT_FALLBACK=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GEMINI_API_KEY=
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_FALLBACK_URL=
OLLAMA_SECONDARY_URL=
OLLAMA_SECONDARY_FALLBACK_URL=
OLLAMA_AUTH_TOKEN=
# Legacy shared-model fallback. Still used as a last-resort default by a few
# of the small, deliberately-cheap "outsourced" tasks (e.g. courseSummary.ts,
# the chat route's conversation-compaction pass) that intentionally do NOT
# go through resolveModelFromKey/OLLAMA_MODEL_MUSE_GLIMMER below - leave
# these as-is, they're not part of the main-model unification.
OLLAMA_MODEL=
# The app's one main model, used everywhere a "large" model is needed: AI
# Chat, quiz generation, flashcard generation, AI advising, Discover
# question generation, AND OCR/vision (Muse Glimmer is multimodal enough to
# cover that too - see src/library/ollamaClient.ts's resolveModelFromKey,
# the single choke point all of those call through). Unified 2026-09-21 -
# previously a per-task choice between 5 benchmarked models (museGlimmer/
# nemotron/qwenCoder/qwen3A3b/fastResident); now only this one is used.
# Outsourced small tasks (embeddings, query clarification, contextual
# chunking, student-profile/course-summary background summarization)
# deliberately stay on their own separate small models below, unaffected by
# this var.
OLLAMA_MODEL_MUSE_GLIMMER=
OLLAMA_EMBED_MODEL=
OLLAMA_SUMMARY_MODEL=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
INTERNAL_API_SECRET=
# Long-running document jobs are processed outside browser requests. Point
# this at this deployment's protected worker endpoint, for example
# https://app.example.edu/api/document-jobs/worker.
OCR_WORKER_URL=
OCR_WORKER_POLL_MS=10000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
COURSE_OFFERING_SOURCE_URL=
QDRANT_URL=
# Public fallback used when QDRANT_URL (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
QDRANT_FALLBACK_URL=
QDRANT_API_KEY=

# Set to "false" to disable the small-model query-clarification pass
# (src/library/queryClarifier.ts) that restates a student's raw message
# before the primary model responds
ENABLE_QUERY_CLARIFICATION=
