NEXT_PUBLIC_FIREBASE_API_KEY=
MINIO_ENDPOINT=
# Public fallback used when MINIO_ENDPOINT (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
MINIO_ENDPOINT_FALLBACK=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GEMINI_API_KEY=
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_FALLBACK_URL=
OLLAMA_SECONDARY_URL=
OLLAMA_SECONDARY_FALLBACK_URL=
OLLAMA_AUTH_TOKEN=
# Default/shared model, used as a fallback wherever a more specific
# OLLAMA_MODEL_* var below isn't set - see src/library/ollamaClient.ts's
# resolveModelFromKey for how the settings page's per-task model choice
# actually resolves to one of these.
OLLAMA_MODEL=
# The "fastResident" model key (src/library/chatMode.ts) resolves here - not
# the default anywhere anymore (superseded by better-benchmarked models, see
# OLLAMA_MODEL_QUALITY below), but still selectable, and small enough to sit
# resident on Primary alongside the vision/OCR model without either evicting
# the other. It's the one model selection the settings page eagerly
# co-warms OLLAMA_OCR_MODEL alongside (see warmEffectiveChatModel in
# settings/page.tsx) - every other selection leaves vision lazy-loaded, and
# a cold-boot swap on first OCR use is expected/fine.
OLLAMA_MODEL_FAST=
# The "qwen3A3b" model key resolves here, and is the practical default
# everywhere a default is needed (see DEFAULT_TASK_MODEL/
# DEFAULT_UNIFIED_MODEL in chatMode.ts) - fastest of the 4 models benchmarked
# 2026-08-13 (188.5 tok/s avg against this app's real prompts/schemas/tools).
# Known issue: this model can leak raw <think> reasoning into its output
# even with think:false - the chat route buffers and strips it before
# streaming to the client (see wrapDeltaForThinkStripping), so this doesn't
# count against it as the default. Evicts (and gets evicted by) the vision
# model like every non-fastResident selection - OCR right after a message
# costs a cold-boot swap, which is expected/fine, not something worth
# engineering around.
OLLAMA_MODEL_QUALITY=
# Per-task model options for the settings page (AI Chat / Quiz / Flashcard
# Generation dropdowns) and the "Reduce cold boots" unified-model option -
# see src/library/chatMode.ts's TASK_MODEL_OPTIONS/UNIFIED_MODEL_OPTIONS
# for the practical-first ordering these feed the dropdowns, and
# src/library/ollamaClient.ts's resolveModelFromKey for how a selection
# resolves to one of these. Benchmarked 2026-08-13 on ollama-primary
# against this app's actual prompts/schemas/tools (flashcard/quiz JSON
# generation, the real tool-calling chat flow through a full multi-round
# tool loop) - all three below correctly emit tool_calls and produce valid
# structured output.
# "museGlimmer" key - 31.7 tok/s avg, best response quality/prose of the
# 4 models tested, slowest.
OLLAMA_MODEL_MUSE_GLIMMER=
# "nemotron" key - 106.8 tok/s avg.
OLLAMA_MODEL_NEMOTRON=
# "qwenCoder" key - 179.4 tok/s avg, cleanest structured-output + tool-use
# reliability of the 4, with no known issues.
OLLAMA_MODEL_QWEN_CODER=
OLLAMA_EMBED_MODEL=
OLLAMA_SUMMARY_MODEL=
# Vision/OCR model. Lazy-loaded (a cold-boot swap on first use is expected)
# for every AI Chat model selection except fastResident (gpt-oss:20b),
# which the settings page eagerly co-warms this alongside - see
# OLLAMA_MODEL_FAST's comment and resolveModelFromKey's "ocr" key.
OLLAMA_OCR_MODEL=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
INTERNAL_API_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
COURSE_OFFERING_SOURCE_URL=
QDRANT_URL=
# Public fallback used when QDRANT_URL (the LAN-direct address) isn't
# reachable, e.g. a teammate developing off the home/school network.
QDRANT_FALLBACK_URL=
QDRANT_API_KEY=

# Set to "false" to disable the small-model query-clarification pass
# (src/library/queryClarifier.ts) that restates a student's raw message
# before the primary model responds
ENABLE_QUERY_CLARIFICATION=
