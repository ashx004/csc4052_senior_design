NEXT_PUBLIC_FIREBASE_API_KEY=
# _URL/_ENDPOINT is your best/fastest reachable option; only ONE of the
# three - _FALLBACK is always the public Cloudflare one, as a last resort.
# Pick the *_URL line for however you're actually connecting and delete
# the other two comments:
#   1. Local  (on the school/home LAN):  http://192.168.1.12:9069
#   2. Tailscale (on the team's tailnet, from anywhere - ask Cameron to
#      share the "debian-1" machine with you): http://100.125.117.99:9069
#   3. Neither: leave this blank and rely on MINIO_ENDPOINT_FALLBACK alone.
# Tailscale is a real WireGuard connection, not a proxy, so unlike option 3
# it doesn't have Cloudflare Tunnel's timeout - matters more for Ollama
# below than for MinIO, but the same three options apply to both.
MINIO_ENDPOINT=
# Public (Cloudflare-tunneled) fallback - used whenever MINIO_ENDPOINT above
# is unreachable. Always keep this set, even if you picked option 1 or 2.
MINIO_ENDPOINT_FALLBACK=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GEMINI_API_KEY=
# Same three options as MINIO_ENDPOINT above:
#   1. Local:      http://192.168.1.12:11434/primary
#   2. Tailscale:  http://100.125.117.99:11434/primary
#   3. Neither: leave blank, rely on OLLAMA_PRIMARY_FALLBACK_URL alone.
# This one matters most: Cloudflare Tunnel's ~100s response timeout (see
# advisingOllama.ts's 502/504/524 handling) can cut off a cold model load or
# a long generation that options 1/2 wouldn't.
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_FALLBACK_URL=
# Only TWO options here, not three - Ollama Secondary's box isn't on the
# team's tailnet (not a member, and nothing advertises a route to it), so
# there's no Tailscale address to give you yet:
#   1. Local:   http://192.168.1.11:11434/secondary
#   2. Neither: leave blank, rely on OLLAMA_SECONDARY_FALLBACK_URL alone.
OLLAMA_SECONDARY_URL=
OLLAMA_SECONDARY_FALLBACK_URL=
OLLAMA_AUTH_TOKEN=
# The app's one large model. Everything on Ollama Primary uses it: AI Chat,
# quiz/flashcard generation, AI advising, Discover question generation,
# course summaries, AND OCR/vision (Muse Glimmer is multimodal enough to
# cover that too) - see src/library/ollamaClient.ts's resolveModelFromKey,
# the single choke point all of those call through. No other large model is
# used anywhere (VRAM is limited) - there is no per-task model choice.
OLLAMA_MODEL_MUSE_GLIMMER=muse-glimmer:latest
# How long Muse Glimmer stays resident after its last use before Ollama
# unloads it (see FAST_MODEL_KEEP_ALIVE in src/library/ollamaClient.ts).
# Defaults to 2h if unset. Accepts any Ollama duration ("30m", "2h", ...).
OLLAMA_MODEL_KEEP_ALIVE=2h
# Small models only, for the outsourced background tasks (Secondary):
# embeddings, plus llama3.2:3b for conversation compaction / student
# profile (OLLAMA_SUMMARY_MODEL), query clarification, and contextual
# chunking.
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_SUMMARY_MODEL=llama3.2:3b
OLLAMA_CLARIFIER_MODEL=llama3.2:3b
OLLAMA_CONTEXT_MODEL=llama3.2:3b
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
INTERNAL_API_SECRET=
# Long-running document jobs are processed outside browser requests. Point
# this at this deployment's protected worker endpoint, for example
# https://app.example.edu/api/document-jobs/worker.
OCR_WORKER_URL=
OCR_WORKER_POLL_MS=10000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
COURSE_OFFERING_SOURCE_URL=

# Same three options as MINIO_ENDPOINT/OLLAMA_PRIMARY_URL above:
#   1. Local:      http://192.168.1.12:6333
#   2. Tailscale:  http://100.125.117.99:6333
#   3. Neither: leave blank, rely on QDRANT_FALLBACK_URL alone.
QDRANT_URL=
# Public fallback - used whenever QDRANT_URL above is unreachable.
QDRANT_FALLBACK_URL=
QDRANT_API_KEY=

# Set to "false" to disable the small-model query-clarification pass
# (src/library/queryClarifier.ts) that restates a student's raw message
# before the primary model responds
ENABLE_QUERY_CLARIFICATION=
