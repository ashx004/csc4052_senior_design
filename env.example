# chunking.
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_SUMMARY_MODEL=llama3.2:3b
OLLAMA_CLARIFIER_MODEL=llama3.2:3b
OLLAMA_CONTEXT_MODEL=llama3.2:3b
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
INTERNAL_API_SECRET=
OCR_WORKER_URL=
OCR_WORKER_POLL_MS=10000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
COURSE_OFFERING_SOURCE_URL=
QDRANT_URL=
QDRANT_FALLBACK_URL=
QDRANT_API_KEY=
# Set to "false" to disable the small-model query-clarification pass
# (src/library/queryClarifier.ts) that restates a student's raw message
# before the primary model responds
ENABLE_QUERY_CLARIFICATION=
