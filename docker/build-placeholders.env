# Dummy server-side values used ONLY while `next build` runs inside the
# Dockerfile's builder stage. Collecting page data imports every route, and a
# few modules construct clients or resolve config at import time (Resend,
# firebase-admin, advisingOllama's model) and throw without a value.
# Nothing here reaches the runtime image: real values come from the server's
# .env, mounted into the container at runtime. FIREBASE_ADMIN_PRIVATE_KEY is
# parsed on import, so the Dockerfile generates a throwaway key for it instead.
OLLAMA_MODEL_MAIN=build-placeholder
RESEND_EMAIL_PRIVATE_KEY=re_build_placeholder
FIREBASE_ADMIN_PROJECT_ID=build-placeholder
FIREBASE_ADMIN_CLIENT_EMAIL=build-placeholder@example.invalid
